# Copiez ce fichier en « .env » puis collez les valeurs de votre projet Firebase
# (console Firebase > Paramètres du projet > Vos applications > Configuration du SDK).
# Sans ces valeurs, l'application démarre en MODE DÉMONSTRATION (données locales au navigateur).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
